{
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "admin.tolimolimyanmar.com"
        }
      ],
      "destination": "/admin.html"
    },
    {
      "source": "/a/:article",
      "destination": "/api/share?article=:article"
    },
    {
      "source": "/c/:cat",
      "destination": "/api/share?cat=:cat"
    },
    {
      "source": "/p/:product",
      "destination": "/api/share?product=:product"
    }
  ]
}