{
  "rewrites": [
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": "(?i).*(telegrambot|twitterbot|facebookexternalhit|facebot|viber|whatsapp).*"
        },
        {
          "type": "query",
          "key": "cat"
        }
      ],
      "destination": "/api/share"
    },
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": "(?i).*(telegrambot|twitterbot|facebookexternalhit|facebot|viber|whatsapp).*"
        },
        {
          "type": "query",
          "key": "product"
        }
      ],
      "destination": "/api/share"
    },
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": "(?i).*(telegrambot|twitterbot|facebookexternalhit|facebot|viber|whatsapp).*"
        },
        {
          "type": "query",
          "key": "item"
        }
      ],
      "destination": "/api/share"
    }
  ]
}