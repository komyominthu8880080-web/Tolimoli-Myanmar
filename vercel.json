{
  "rewrites": [
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": ".*(TelegramBot|twitterbot|facebookexternalhit|Facebot|Viber|WhatsApp).*"
        },
        {
          "type": "query",
          "key": "cat"
        }
      ],
      "destination": "/api/share"
    },
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": ".*(TelegramBot|twitterbot|facebookexternalhit|Facebot|Viber|WhatsApp).*"
        },
        {
          "type": "query",
          "key": "product"
        }
      ],
      "destination": "/api/share"
    },
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": ".*(TelegramBot|twitterbot|facebookexternalhit|Facebot|Viber|WhatsApp).*"
        },
        {
          "type": "query",
          "key": "item"
        }
      ],
      "destination": "/api/share"
    }
  ]
}