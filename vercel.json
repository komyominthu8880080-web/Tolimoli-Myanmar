{
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/c/:cat",
      "destination": "/api/share?cat=:cat"
    },
    {
      "source": "/p/:product",
      "destination": "/api/share?product=:product"
    },
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "query",
          "key": "article"
        }
      ],
      "destination": "/api/share.js"
    },
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "query",
          "key": "product"
        }
      ],
      "destination": "/api/share.js"
    }
  ]
}